OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

SODA_STRAW_MCP_URL=https://srikanthganta.straw.demo.soda.io/mcp
SODA_STRAW_AGENT_API_KEY=

# shadcn MCP is started by the Next server on first chat request.
ENABLE_SHADCN_MCP=true

# Security: API key for /api/chat endpoint authentication
# If set, requests must include "Authorization: Bearer <key>" header to access MCP tools
# If not set, MCP tools are only available when ALLOW_UNAUTHENTICATED_MCP_TOOLS=true
FLUID_OS_CHAT_API_KEY=

# Security: Allow unauthenticated access to MCP tools (development only)
# Set to "true" only in trusted development environments
# In production, always set FLUID_OS_CHAT_API_KEY and leave this unset or "false"
ALLOW_UNAUTHENTICATED_MCP_TOOLS=
