OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

SODA_STRAW_MCP_URL=https://srikanthganta.straw.demo.soda.io/mcp
SODA_STRAW_AGENT_API_KEY=

# shadcn MCP is started by the Next server on first chat request.
ENABLE_SHADCN_MCP=true

# Security: API key for /api/chat endpoint authentication
# If set, requests must include "Authorization: Bearer <key>" header to access MCP tools
# If not set, MCP tools are only available when ALLOW_UNAUTHENTICATED_MCP_TOOLS=true
FLUID_OS_CHAT_API_KEY=

# Security: Allow unauthenticated access to MCP tools (development only)
# Set to "true" only in trusted development environments
# In production, always set FLUID_OS_CHAT_API_KEY and leave this unset or "false"
ALLOW_UNAUTHENTICATED_MCP_TOOLS=

# Security: API key for /api/capability-call endpoint authentication (server-side)
# If set, requests must include "Authorization: Bearer <key>" header to access backend capabilities
# If not set, capabilities are only available when ALLOW_UNAUTHENTICATED_CAPABILITIES=true
FLUID_OS_CAPABILITY_API_KEY=

# Security: API key for /api/capability-call endpoint authentication (client-side)
# This should match FLUID_OS_CAPABILITY_API_KEY for client-side widget calls
# Only set this if you want client-side widgets to authenticate to the capability-call endpoint
NEXT_PUBLIC_CAPABILITY_API_KEY=

# Security: Allow unauthenticated access to backend capabilities (development only)
# Set to "true" only in trusted development environments
# In production, always set FLUID_OS_CAPABILITY_API_KEY and leave this unset or "false"
ALLOW_UNAUTHENTICATED_CAPABILITIES=

# Backend API key for authenticating with the backend service
# This key is used by the Next.js server to authenticate with the backend
# Must match the FLUID_OS_API_KEY set in the backend environment
FLUID_OS_API_KEY=


